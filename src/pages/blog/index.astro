---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Blog — Jack Myers">
  <div class="container">
    <h1>Writing</h1>
    {posts.length === 0 ? (
      <p class="dim">
        Nothing published yet — a technical write-up on the current research
        program is in the works. In the meantime, the
        <a href="/projects/">projects page</a> is the best overview.
      </p>
    ) : (
      <ul style="list-style: none; padding: 0;">
        {posts.map((post) => (
          <li style="margin: 1.4rem 0;">
            <a href={`/blog/${post.id}/`} style="font-size: 1.15rem; font-weight: 600;">{post.data.title}</a>
            <div class="dim" style="font-size: 0.85rem;">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
            {post.data.description && <p style="margin: 0.3rem 0 0;">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
